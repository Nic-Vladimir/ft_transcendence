localhost:80 {
    redir https://{host}:8443{uri} permanent
}

localhost:443 {
    tls internal
    log

    @ws path /ws
    handle @ws {
        reverse_proxy trivia-ws:3000
    }

    @packs path /ws/packs
    handle @packs {
        uri strip_prefix /ws
        reverse_proxy trivia-ws:3000
    }

    handle {
        reverse_proxy frontend:3000
    }
}