localhost:80 {
    redir https://{host}:8443{uri} permanent
}

localhost:443 {
    tls internal
    log

    handle {
        reverse_proxy frontend:3000
    }

    # Kibana → Elastic Stack UI
    handle /kibana* {
        reverse_proxy kibana:5601
    }

    # Static fallback only for root /
    handle / {
        root * /srv
        file_server
        try_files {path} /index.html
    }
}
